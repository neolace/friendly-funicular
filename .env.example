# Frontend (apps/web) — every VITE_ value is shipped to the browser.
# These are public identifiers, never secrets. Copy to apps/web/.env.local.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
VITE_API_BASE_URL=https://xxxxxxxx.lambda-url.eu-west-1.on.aws

# Infrastructure (infra) — read by `cdk synth` / `cdk deploy`.
DEPLOY_ENV=dev
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
